                    "program_line": "Set central_ac_and_furnace_airloop_Fan_RTF = central_ac_and_furnace_airloop_Fan_RTF + central_ac_and_furnace_airloop_Fan_RTF_s"
                },
                {
                    "program_line": "Set central_ac_and_furnace_airloop_Fan_RTF = central_ac_and_furnace_airloop_Fan_RTF + central_ac_and_furnace_airloop_Fan_RTF_s_1"
