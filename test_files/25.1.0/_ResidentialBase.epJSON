    "EnergyManagementSystem:Subroutine": {
        "central_ac_and_furnace_airloop_0_duct_subroutine": {
            "lines": [
                {
                    "program_line": "Set AH_MFR = central_ac_and_furnace_airloop_AH_MFR / 1"
                },
                {
                    "program_line": "If AH_MFR > 0"
                },
                {
                    "program_line": "Set AH_Tout = central_ac_and_furnace_airloop_AH_Tout"
                },
                {
                    "program_line": "Set AH_Wout = central_ac_and_furnace_airloop_AH_Wout"
                },
                {
                    "program_line": "Set RA_T = central_ac_and_furnace_airloop_RA_T"
                },
                {
                    "program_line": "Set RA_W = central_ac_and_furnace_airloop_Ra_W"
                },
                {
                    "program_line": "Set Fan_RTF = central_ac_and_furnace_airloop_Fan_RTF"
                },
                {
                    "program_line": "Set DZ_T = central_ac_and_furnace_airloop_0_DZ_T"
                },
                {
                    "program_line": "Set DZ_W = central_ac_and_furnace_airloop_0_DZ_W"
                },
                {
                    "program_line": "Set AH_VFR = central_ac_and_furnace_airloop_AH_VFR / 1"
                },
                {
                    "program_line": "Set h_SA = (@HFnTdbW AH_Tout AH_Wout)"
                },
                {
                    "program_line": "Set h_RA = (@HFnTdbW RA_T RA_W)"
                },
                {
                    "program_line": "Set h_fg = (@HfgAirFnWTdb AH_Wout AH_Tout)"
                },
                {
                    "program_line": "Set h_DZ = (@HFnTdbW DZ_T DZ_W)"
                },
                {
                    "program_line": "Set air_cp = 1006.0"
                },
                {
                    "program_line": "Set f_sup = 0.035396 / (central_ac_and_furnace_airloop_max_sup_fan_mfr/1 * 1.0135)"
                },
                {
                    "program_line": "Set f_ret = 0.011799 / (central_ac_and_furnace_airloop_max_sup_fan_mfr/1 * 1.0135)"
                },
                {
                    "program_line": "Set sup_lk_mfr = f_sup * AH_MFR"
                },
                {
                    "program_line": "Set ret_lk_mfr = f_ret * AH_MFR"
                },
                {
                    "program_line": "Set SupTotLkToCond = sup_lk_mfr*(h_RA - h_SA)"
                },
                {
                    "program_line": "Set SupLatLkToCond = sup_lk_mfr*h_fg*(RA_W-AH_Wout)"
                },
                {
                    "program_line": "Set SupSensLkToCond = SupTotLkToCond-SupLatLkToCond"
                },
                {
                    "program_line": "Set supply_ua = 18.065"
                },
                {
                    "program_line": "Set eTm = 0-((Fan_RTF/(AH_MFR*air_cp))*supply_ua)"
                },
                {
                    "program_line": "Set t_sup = DZ_T+((AH_Tout-DZ_T)*(@Exp eTm))"
                },
                {
                    "program_line": "Set SupCondToCond = AH_MFR*air_cp*(t_sup-AH_Tout)"
                },
                {
                    "program_line": "Set SupCondToDZ = 0-SupCondToCond"
                },
                {
                    "program_line": "Set return_ua = 15.515"
                },
                {
                    "program_line": "Set eTm = 0-((Fan_RTF/(AH_MFR*air_cp))*return_ua)"
                },
                {
                    "program_line": "Set t_ret = DZ_T+((RA_T-DZ_T)*(@Exp eTm))"
                },
                {
                    "program_line": "Set RetCondToRP = AH_MFR*air_cp*(t_ret-RA_T)"
                },
                {
                    "program_line": "Set RetCondToDZ = 0-RetCondToRP"
                },
                {
                    "program_line": "Set RetLatLkToRP = 0"
                },
                {
                    "program_line": "Set RetSensLkToRP = ret_lk_mfr*air_cp*(DZ_T-RA_T)"
                },
                {
                    "program_line": "Set SupTotLkToDZ = sup_lk_mfr*(h_SA-h_DZ)"
                },
                {
                    "program_line": "Set SupLatLkToDZ = sup_lk_mfr*h_fg*(AH_Wout-DZ_W)"
                },
                {
                    "program_line": "Set SupSensLkToDZ = SupTotLkToDZ-SupLatLkToDZ"
                },
                {
                    "program_line": "Set FracOutsideToCond = 0.5"
                },
                {
                    "program_line": "Set FracOutsideToDZ = 0.0"
                },
                {
                    "program_line": "Set FracCondToOutside = 0.0"
                },
                {
                    "program_line": "Set FracDZToOutside = 0.5"
                },
                {
                    "program_line": "Set FracDZToCond = 0.5"
                },
                {
                    "program_line": "Set FracCondToDZ = 0.0"
                },
                {
                    "program_line": "Set lk_imbal_vfr = @ABS(f_sup - f_ret) * AH_VFR"
                },
                {
                    "program_line": "Set ImbalLkCondToDZ = lk_imbal_vfr * FracCondToDZ"
                },
                {
                    "program_line": "Set ImbalLkDZToCond = lk_imbal_vfr * FracDZToCond"
                },
                {
                    "program_line": "Set ImbalLkOutsideToCond = lk_imbal_vfr * FracOutsideToCond"
                },
                {
                    "program_line": "Set ImbalLkOutsideToDZ = lk_imbal_vfr * FracOutsideToDZ"
                },
                {
                    "program_line": "Set ImbalLkCondToOutside = lk_imbal_vfr * FracCondToOutside"
                },
                {
                    "program_line": "Set ImbalLkDZToOutside = lk_imbal_vfr * FracDZToOutside"
                },
                {
                    "program_line": "Else"
                },
                {
                    "program_line": "Set SupLatLkToCond = 0"
                },
                {
                    "program_line": "Set SupSensLkToCond = 0"
                },
                {
                    "program_line": "Set SupCondToCond = 0"
                },
                {
                    "program_line": "Set RetCondToRP = 0"
                },
                {
                    "program_line": "Set RetLatLkToRP = 0"
                },
                {
                    "program_line": "Set RetSensLkToRP = 0"
                },
                {
                    "program_line": "Set RetCondToDZ = 0"
                },
                {
                    "program_line": "Set SupCondToDZ = 0"
                },
                {
                    "program_line": "Set SupLatLkToDZ = 0"
                },
                {
                    "program_line": "Set SupSensLkToDZ = 0"
                },
                {
                    "program_line": "Set ImbalLkCondToDZ = 0"
                },
                {
                    "program_line": "Set ImbalLkDZToCond = 0"
                },
                {
                    "program_line": "Set ImbalLkOutsideToCond = 0"
                },
                {
                    "program_line": "Set ImbalLkOutsideToDZ = 0"
                },
                {
                    "program_line": "Set ImbalLkCondToOutside = 0"
                },
                {
                    "program_line": "Set ImbalLkDZToOutside = 0"
                },
                {
                    "program_line": "EndIf"
                },
                {
                    "program_line": "Set central_ac_and_furnace_airloop_0_SupLatLkToCond = SupLatLkToCond"
                },
                {
                    "program_line": "Set central_ac_and_furnace_airloop_0_SupSensLkToCond = SupSensLkToCond"
                },
                {
                    "program_line": "Set central_ac_and_furnace_airloop_0_SupCondToLv = SupCondToCond"
                },
                {
                    "program_line": "Set central_ac_and_furnace_airloop_0_RetCondToRP = RetCondToRP"
                },
                {
                    "program_line": "Set central_ac_and_furnace_airloop_0_RetLatLkToRP = RetLatLkToRP"
                },
                {
                    "program_line": "Set central_ac_and_furnace_airloop_0_RetSensLkToRP = RetSensLkToRP"
                },
                {
                    "program_line": "Set central_ac_and_furnace_airloop_0_RetCondToDZ = RetCondToDZ"
                },
                {
                    "program_line": "Set central_ac_and_furnace_airloop_0_SupCondToDZ = SupCondToDZ"
                },
                {
                    "program_line": "Set central_ac_and_furnace_airloop_0_SupLatLkToDZ = SupLatLkToDZ"
                },
                {
                    "program_line": "Set central_ac_and_furnace_airloop_0_SupSensLkToDZ = SupSensLkToDZ"
                },
                {
                    "program_line": "Set central_ac_and_furnace_airloop_0_ZoneMixCondToDZ = ImbalLkCondToDZ"
                },
                {
                    "program_line": "Set central_ac_and_furnace_airloop_0_ZoneMixDZToCond = ImbalLkDZToCond"
                },
                {
                    "program_line": "Set central_ac_and_furnace_airloop_0_DuctImbalLkSupFanEquivCond = ImbalLkCondToOutside"
                },
                {
                    "program_line": "Set central_ac_and_furnace_airloop_0_DuctImbalLkExhFanEquivCond = ImbalLkOutsideToCond"
                },
                {
                    "program_line": "Set central_ac_and_furnace_airloop_0_DuctImbalLkSupFanEquivDZ = ImbalLkDZToOutside"
                },
                {
                    "program_line": "Set central_ac_and_furnace_airloop_0_DuctImbalLkExhFanEquivDZ = ImbalLkOutsideToDZ"
                }
            ]
        }
    },
