                {
                    "program_line": "Set central_ac_and_furnace_airloop_0_RetSensLkToRP_equip_act = central_ac_and_furnace_airloop_0_RetSensLkToRP"
                },
                {
                    "program_line": "Set central_ac_and_furnace_airloop_0_RetLatLkToRP_equip_act = central_ac_and_furnace_airloop_0_RetLatLkToRP"
                },
                {
                    "program_line": "Set central_ac_and_furnace_airloop_0_RetCondToRP_equip_act = central_ac_and_furnace_airloop_0_RetCondToRP"
                },
                {
                    "program_line": "Set central_ac_and_furnace_airloop_0_RetCondToDZ_equip_act = central_ac_and_furnace_airloop_0_RetCondToDZ"
                },
                {
                    "program_line": "Set central_ac_and_furnace_airloop_0_SupCondToDZ_equip_act = central_ac_and_furnace_airloop_0_SupCondToDZ"
                },
                {
                    "program_line": "Set central_ac_and_furnace_airloop_0_SupSensLkToDZ_equip_act = central_ac_and_furnace_airloop_0_SupSensLkToDZ"
                },
                {
                    "program_line": "Set central_ac_and_furnace_airloop_0_SupLatLkToDZ_equip_act = central_ac_and_furnace_airloop_0_SupLatLkToDZ"
                },
                {
                    "program_line": "Set central_ac_and_furnace_airloop_0_ZoneMixDZToCond_mix_act = central_ac_and_furnace_airloop_0_ZoneMixDZToCond"
                },
                {
                    "program_line": "Set central_ac_and_furnace_airloop_0_ZoneMixCondToDZ_mix_act = central_ac_and_furnace_airloop_0_ZoneMixCondToDZ"
                }
            ]
        },
        "central_ac_and_furnace_supply_fan_disaggregate_program": {
            "lines": [
                {
                    "program_line": "Set central_ac_and_furnace_supply_fan_clg = 0"
